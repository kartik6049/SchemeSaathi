{
  "name": "schemesaathi-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SchemeSaathi API: rules engine, scheme catalogue, checklist PDF and admin APIs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx src/db/migrate.ts --reset && tsx src/db/seed/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "perf": "tsx scripts/perf-match.ts",
    "data:extract": "tsx scripts/data/extract-pdfs.ts",
    "data:build": "tsx scripts/data/build-catalogue.ts",
    "data:translate:export": "tsx scripts/data/translate-export.ts",
    "data:translate:merge": "tsx scripts/data/translate-merge.ts",
    "db:import": "tsx src/db/import/index.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "pdfjs-dist": "^4.10.38",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
