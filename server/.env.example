# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=4000
# Docker Postgres from ../docker-compose.yml (host port 5433, localhost only)
DATABASE_URL=postgres://saathi:saathi_dev_pw@127.0.0.1:5433/schemesaathi
TEST_DATABASE_URL=postgres://saathi:saathi_dev_pw@127.0.0.1:5433/schemesaathi_test
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Used only by `npm run db:seed` to create the first admin account
ADMIN_EMAIL=admin@schemesaathi.local
ADMIN_PASSWORD=ChangeMe!2026
API_RATE_LIMIT=300
